@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<div class="container-fluid p-0">

    <!-- Hero Section -->
    <header class="hero-section text-center text-white py-5"
            style="background-image: url('@Url.Content("~/Images/hero-city-sunset.jpg")'); background-size: cover; background-position: center;">
        <div class="overlay d-flex flex-column justify-content-center align-items-center py-5">
            <img src="@Url.Content("~/Images/logo.jpg")" alt="Municipality Logo" class="municipality-logo mb-3" />
            <h1 class="display-3 fw-bold">Welcome to Municipal Services</h1>
            <p class="lead">A simple, professional platform to report issues and access community services.</p>
            <hr class="my-4 w-50">

            <div class="btn-group flex-wrap">
                <a asp-controller="ReportIssues" asp-action="Create" class="btn btn-success btn-lg px-4 py-3 m-2 shadow cta-button">
                    Report Issues
                </a>
                <a asp-controller="Events" asp-action="Index" class="btn btn-success btn-lg px-4 py-3 m-2 shadow cta-button">
                    Local Events & Announcements
                </a>
                <a asp-controller="ServiceRequest" asp-action="Index" class="btn btn-success btn-lg px-4 py-3 m-2 shadow cta-button">
                    Service Request Status
                </a>
            </div>
        </div>
    </header>

    <!-- Features Section -->
    <section class="features-section text-center my-5 container">
        <h2 class="mb-4">Why Use Our Services?</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <img src="@Url.Content("~/Images/city-dawn.jpg")" class="card-img-top" alt="Fast issue reporting">
                    <div class="card-body">
                        <h5 class="card-title">Quick & Easy Reports</h5>
                        <p class="card-text">Log municipal issues in minutes and track their progress in real-time.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <img src="@Url.Content("~/Images/city-waterfront.jpg")" class="card-img-top" alt="Community updates">
                    <div class="card-body">
                        <h5 class="card-title">Stay Informed</h5>
                        <p class="card-text">Access upcoming community events and important announcements.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <img src="@Url.Content("~/Images/night-skyline.jpg")" class="card-img-top" alt="Secure platform">
                    <div class="card-body">
                        <h5 class="card-title">Secure & Transparent</h5>
                        <p class="card-text">Your data is safely managed, ensuring full transparency in services.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Community Engagement Preview Section -->
    <section class="cta-section my-5 py-5 bg-light">
        <div class="container">
            <div class="row align-items-center">
                <!-- Image Column -->
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <img src="@Url.Content("~/Images/community-engagement.jpg")"
                         class="img-fluid rounded-4 shadow cta-image"
                         alt="Community engagement illustration">
                </div>

                <!-- Text Column -->
                <div class="col-lg-6 text-center text-lg-start">
                    <h2 class="display-5 fw-bold mb-3 cta-text">Participate in Shaping Your Municipality</h2>
                    <p class="lead mb-4">Take surveys, submit suggestions, and join co-creation workshops to help improve municipal services for your community.</p>
                    <a asp-controller="Community" asp-action="Engagement"
                       class="btn btn-success btn-lg px-5 shadow cta-button">
                        Engage Now
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section my-5 py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <img src="@Url.Content("~/Images/together.jpg")"
                         class="img-fluid rounded-4 shadow cta-image"
                         alt="Join community illustration">
                </div>
                <div class="col-lg-6 text-center text-lg-start">
                    <h2 class="display-5 fw-bold mb-3 cta-text">Help us build a better community together.</h2>
                    <a asp-controller="ReportIssues" asp-action="Create"
                       class="btn btn-success btn-lg px-5 shadow cta-button">
                        Start Reporting
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>
