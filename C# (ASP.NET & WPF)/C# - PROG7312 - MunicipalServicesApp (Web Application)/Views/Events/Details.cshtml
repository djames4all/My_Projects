@model MunicipalServicesApp.Models.EventModel
@{
    ViewData["Title"] = Model.Title;

    var recs = ViewBag.Recommendations as IEnumerable<MunicipalServicesApp.Models.EventModel> ?? Enumerable.Empty<MunicipalServicesApp.Models.EventModel>();
    var recently = ViewBag.RecentlyViewed as IEnumerable<MunicipalServicesApp.Models.EventModel> ?? Enumerable.Empty<MunicipalServicesApp.Models.EventModel>();
}

<div class="container my-4">
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="mb-1">@ViewData["Title"]</h1>
            <p>Explore details about this community event and related activities.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-light" href="@Url.Action("Index", "Events")">
                <i class="bi bi-arrow-left-circle"></i> Back to Events
            </a>
            <a class="btn btn-outline-light" href="@Url.Action("Index", "Home")">
                <i class="bi bi-house-door"></i> Back to Home
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-success mb-3 overflow-hidden" style="border-radius: 1rem;">
                <div class="image-wrapper" style="height: 380px; overflow: hidden; border-top-left-radius: 1rem; border-top-right-radius: 1rem;">
                    <img src="@Model.ImageUrl" alt="@Model.Title"
                         style="width: 100%; height: 100%; object-fit: cover; display: block; border-top-left-radius: 1rem; border-top-right-radius: 1rem;" />
                </div>
                <div class="card-body">
                    <h3 class="fw-semibold text-success mb-2">@Model.Title</h3>
                    <div class="small text-muted mb-1">
                        <i class="bi bi-calendar-event"></i>
                        @Model.StartDate.ToString("dddd, dd MMM yyyy HH:mm")
                        @if (Model.EndDate.HasValue)
                        {
                            <text> – @Model.EndDate.Value.ToString("dd MMM yyyy HH:mm")</text>
                        }
                    </div>
                    <div class="small text-muted mb-3">
                        <i class="bi bi-geo-alt"></i> @Model.Location •
                        <span class="badge bg-secondary">@Model.Category</span>
                    </div>
                    <p class="mb-3">@Model.Description</p>
                    <div class="mb-3">
                        @foreach (var t in Model.Tags)
                        {
                            <span class="badge bg-light text-dark me-1">@t</span>
                        }
                    </div>
                    <div class="mt-3">
                        <form asp-action="AddToCalendar" asp-controller="Calendar" method="post" style="display:inline;">
                            <input type="hidden" name="Id" value="@Model.Id" />
                            <input type="hidden" name="Title" value="@Model.Title" />
                            <input type="hidden" name="StartDate" value="@Model.StartDate" />
                            <input type="hidden" name="EndDate" value="@Model.EndDate" />
                            <input type="hidden" name="Location" value="@Model.Location" />
                            <input type="hidden" name="Category" value="@Model.Category" />
                            <input type="hidden" name="Description" value="@Model.Description" />
                            <button type="submit" class="btn btn-success me-2">
                                <i class="bi bi-calendar-plus"></i> Add to Calendar
                            </button>
                        </form>
                        <a class="btn btn-outline-secondary me-2" href="@Url.Action("Index", "Calendar")">
                            <i class="bi bi-calendar3"></i> View My Calendar
                        </a>
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Events")">
                            <i class="bi bi-arrow-left"></i> Back to Events
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top:85px;">
                <!-- Recommendations -->
                <div class="card shadow-sm border-success mb-3">
                    <div class="card-body">
                        <h6 class="mb-2 text-success">People also viewed</h6>
                        @if (recs.Any())
                        {
                            @foreach (var r in recs)
                            {
                                <div class="mb-2">
                                    <a class="fw-semibold text-success" href="@Url.Action("Details", "Events", new { id = r.Id })">@r.Title</a>
                                    <div class="small text-muted">@r.StartDate.ToString("dd MMM") • @r.Category</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="small text-muted">No related events found.</div>
                        }
                    </div>
                </div>

                <!-- Recently Viewed -->
                <div class="card shadow-sm border-success">
                    <div class="card-body">
                        <h6 class="mb-2 text-success">Recently viewed</h6>
                        @if (recently.Any())
                        {
                            @foreach (var r in recently)
                            {
                                <div class="mb-2">
                                    <a class="text-success" href="@Url.Action("Details", "Events", new { id = r.Id })">@r.Title</a>
                                    <div class="small text-muted">@r.StartDate.ToString("dd MMM") • @r.Category</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="small text-muted">No recently viewed events yet.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
