@model IEnumerable<MunicipalServicesApp.Models.ReportIssue>
@{
    ViewData["Title"] = "Reported Issues";
    Layout = "_Layout";
}

<div class="report-issues-header text-center mb-4">
    <h2>Reported Issues</h2>
    <p class="text-muted">All submitted reports (newest first). Staff can update status directly below.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Location</th>
                        <th>Attachment</th>
                        <th>Submitted</th>
                        <th>Status</th>
                        <th>Update</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No issues reported yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr id="issue-@item.Id">
                                <td>@item.Category</td>
                                <td>@Html.Raw(Html.Encode(item.Description).Replace("\n","<br/>"))</td>
                                <td>@item.Location</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.MediaFilePath))
                                    {
                                        <a href="@item.MediaFilePath" target="_blank" class="btn btn-sm btn-outline-success">View</a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">None</span>
                                    }
                                </td>
                                <td>@item.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="status-badge">
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                        <span class="badge bg-primary">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Resolved</span>
                                    }
                                </td>
                                <td>
                                    <select class="form-select form-select-sm update-status" data-id="@item.Id" style="min-width:140px;">
                                        <option value="Pending" selected="@(item.Status == "Pending")">Pending</option>
                                        <option value="In Progress" selected="@(item.Status == "In Progress")">In Progress</option>
                                        <option value="Resolved" selected="@(item.Status == "Resolved")">Resolved</option>
                                    </select>

                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3 d-flex justify-content-between">
    <a asp-action="Create" class="btn btn-dark">Report Another Issue</a>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Main Menu</a>
</div>

@section Scripts {
    <script>
        // showToast utility (color-coded)
        function showToast(message, type, status) {
            var toastId = 'toast-' + Date.now();
            var bgClass = '';

            if (type === 'success') {
                if (status === 'Pending') bgClass = 'bg-warning text-dark';
                else if (status === 'In Progress') bgClass = 'bg-primary text-white';
                else if (status === 'Resolved') bgClass = 'bg-success text-white';
                else bgClass = 'bg-success text-white';
            } else {
                bgClass = 'bg-danger text-white';
            }

            var toastHtml = `
                <div id="${toastId}" class="toast align-items-center ${bgClass} border-0 shadow-sm mb-2" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            `;
            $('#toastContainer').append(toastHtml);
            var toastEl = document.getElementById(toastId);
            var bsToast = new bootstrap.Toast(toastEl, { delay: 3000 });
            bsToast.show();
            toastEl.addEventListener('hidden.bs.toast', function () { toastEl.remove(); });
        }

        // AJAX status update
        $(document).ready(function () {
            $('.update-status').change(function () {
                var select = $(this);
                var id = select.data('id');
                var newStatus = select.val();
                var row = $('#issue-' + id);

                $.ajax({
                    url: '@Url.Action("UpdateStatusAjax", "ReportIssues")',
                    method: 'POST',
                    data: { id: id, status: newStatus },
                    success: function (res) {
                        if (res.success) {
                            var badgeHtml = '';
                            if (res.newStatus === 'Pending') badgeHtml = '<span class="badge bg-warning text-dark">Pending</span>';
                            else if (res.newStatus === 'In Progress') badgeHtml = '<span class="badge bg-primary">In Progress</span>';
                            else badgeHtml = '<span class="badge bg-success">Resolved</span>';

                            var badgeCell = row.find('.status-badge');
                            badgeCell.html(badgeHtml);

                            // badge pulse
                            var badge = badgeCell.find('.badge');
                            badge.addClass('animate-update');
                            setTimeout(function () { badge.removeClass('animate-update'); }, 700);

                            // row highlight
                            row.addClass('row-updated');
                            setTimeout(function () { row.removeClass('row-updated'); }, 1200);

                            // toast (color-coded)
                            showToast('Status updated to ' + res.newStatus, 'success', res.newStatus);
                        } else {
                            showToast('Error updating status', 'error');
                        }
                    },
                    error: function () {
                        showToast('Error updating status', 'error');
                    }
                });
            });
        });
    </script>
}
