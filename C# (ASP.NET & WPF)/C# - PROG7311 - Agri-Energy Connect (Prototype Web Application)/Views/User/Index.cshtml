@model List<Prog7311_POE_Part2.Models.UserRoleViewModel>

@{
    ViewData["Title"] = "Manage Users";
}

<!-- Optional Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container py-4">
    <div class="card shadow rounded-4 border-0">
        <div class="card-body">
            <h2 class="card-title text-center mb-4 text-primary">User Management</h2>

            <div class="table-responsive">
                <table class="table table-hover table-bordered align-middle text-center">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge bg-@(user.IsEmployee ? "primary" : "success") px-3 py-2">
                                        @(user.IsEmployee ? "Employee" : "Farmer")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        <!-- Edit -->
                                        <a asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-sm btn-warning">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </a>

                                        <!-- Delete -->
                                        <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Are you sure you want to delete this user?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash me-1"></i> Delete
                                            </button>
                                        </form>

                                        <!-- Promote (only if not already employee) -->
                                        @if (!user.IsEmployee)
                                        {
                                            <form asp-action="Promote" method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@user.UserId" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-arrow-up-circle me-1"></i> Promote
                                                </button>
                                            </form>
                                        }

                                        <!-- View Products -->
                                        <a asp-action="ProductsByUser" asp-route-id="@user.UserId" class="btn btn-sm btn-info">
                                            <i class="bi bi-box-seam me-1"></i> Products
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
